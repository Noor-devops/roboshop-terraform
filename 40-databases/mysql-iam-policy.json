{
	"Version": "2012-10-17",
	"Statement": [
		{
			"Sid": "AllowReadSSM",
			"Effect": "Allow",
			"Action": "ssm:GetParameter",
			"Resource": "arn:aws:ssm:us-east-1:160885265516:parameter/roboshop/dev/mysql_root_password"
		},
		{
			"Sid": "AllowDescribeSSM",
			"Effect": "Allow",
			"Action": "ssm:DescribeParameters",
			"Resource": "*"
		},
		{
			"Sid": "AllowDecryptKMS",
			"Effect": "Allow",
			"Action": "kms:Decrypt",
			"Resource": "arn:aws:kms:us-east-1:160885265516:key/*"
		}
	]
}



